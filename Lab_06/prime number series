//Prime number series 


#include <stdio.h>

int main()
{
    printf("my name is samriddhi agrawal")
    int n, i, j, count;

    printf("Enter the limit: ");
    scanf("%d", &n);

    printf("Prime numbers are: ");

    for(i = 2; i <= n; i++)
    {
        count = 0;

        for(j = 1; j <= i; j++)
        {
            if(i % j == 0)
            {
                count++;
            }
        }

        if(count == 2)
        {
            printf("%d ", i);
        }
    }

    return 0;
}
