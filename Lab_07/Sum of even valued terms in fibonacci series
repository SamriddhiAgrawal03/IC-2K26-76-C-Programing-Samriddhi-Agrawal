#include <stdio.h>

int main()
{
    printf("Samriddhi Agrawal solving for Fibonacci series and sum of even terms\n");

    int n, a = 0, b = 1, c, i, sum = 0;

    printf("Enter the number of terms: ");
    scanf("%d", &n);

    printf("Fibonacci series: ");

    for(i = 1; i <= n; i++)
    {
        printf("%d ", a);

        if(a % 2 == 0)
        {
            sum = sum + a;
        }

        c = a + b;
        a = b;
        b = c;
    }

    printf("\nSum of even terms = %d", sum);

    return 0;
}
