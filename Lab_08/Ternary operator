//Ternary operator 


#include <stdio.h>

int main()
{
    Printf("Samriddhi Agrawal solving for ternary operator/n");
    int a, b, c, greatest;

    printf("Enter three numbers: ");
    scanf("%d %d %d", &a, &b, &c);

    greatest = (a > b) ? ((a > c) ? a : c) : ((b > c) ? b : c);

    printf("Greatest number = %d", greatest);

    return 0;
}
